{
  "name": "usage-monitor",
  "version": "1.0.0",
  "description": "Windows flyout + chips meters for Claude Code, Codex, Gemini, and Grok Build",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Shivam Bajpai",
  "repository": {
    "type": "git",
    "url": "https://github.com/sb-git-cs/usage-monitor.git"
  },
  "homepage": "https://github.com/sb-git-cs/usage-monitor",
  "bugs": {
    "url": "https://github.com/sb-git-cs/usage-monitor/issues"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "start:silent": "node scripts/start.js",
    "start:fg": "electron .",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "icon": "node scripts/make-ico.js",
    "dist": "node scripts/make-ico.js && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.usage-monitor",
    "productName": "Usage Monitor",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/taskbar-layout.ps1",
        "to": "taskbar-layout.ps1"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/ui/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Usage Monitor",
      "artifactName": "UsageMonitor-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "UsageMonitor-portable-${version}.exe"
    }
  }
}
