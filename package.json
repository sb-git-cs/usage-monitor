{
  "name": "usage-monitor",
  "version": "1.0.0",
  "description": "Plan meters for Claude Code, Codex, Gemini and Grok Build, plus per-app network usage, for Windows, macOS and Linux",
  "main": "src/main.js",
  "private": true,
  "license": "MIT",
  "author": "Shivam Bajpai",
  "repository": {
    "type": "git",
    "url": "https://github.com/sb-git-cs/usage-monitor.git"
  },
  "homepage": "https://github.com/sb-git-cs/usage-monitor",
  "bugs": {
    "url": "https://github.com/sb-git-cs/usage-monitor/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:ui": "electron scripts/ui-smoke.js",
    "start": "node scripts/start.js",
    "start:silent": "node scripts/start.js",
    "start:fg": "electron .",
    "setup": "node scripts/setup.js",
    "icon": "node scripts/make-ico.js",
    "screenshots": "electron scripts/screenshots.js",
    "dist": "node scripts/make-ico.js && electron-builder --win --x64 --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.usage-monitor",
    "productName": "Usage Monitor",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/ui/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "extraResources": [
        {
          "from": "scripts/taskbar-layout.ps1",
          "to": "taskbar-layout.ps1"
        },
        {
          "from": "helpers/windows",
          "to": "net-helper",
          "filter": [
            "NetCapture.cs",
            "setup.ps1"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Usage Monitor",
      "artifactName": "UsageMonitor-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "UsageMonitor-portable-${version}.exe"
    },
    "mac": {
      "icon": "src/ui/icon-1024.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "src/ui/icon-1024.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "synopsis": "Plan and network usage monitor"
    },
    "dmg": {
      "artifactName": "UsageMonitor-${version}-${arch}.dmg"
    },
    "appImage": {
      "artifactName": "UsageMonitor-${version}-${arch}.AppImage"
    }
  }
}
